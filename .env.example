# Required to authenticate real Telegram Mini App requests in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=mintai_demo_bot
REFERRAL_SALT=replace-with-a-long-random-secret

# Local-only identity used when no Telegram bot token is configured.
ALLOW_DEMO_AUTH=true
DEMO_USER_ID=10001
ALLOW_DEMO_PAYMENTS=true

# Admin endpoint and treasury display/accounting target.
ADMIN_TOKEN=replace-with-a-long-random-secret
ADMIN_API_URL=http://127.0.0.1:8000
TREASURY_ACCOUNT=Mint AI Treasury

# Comma-separated origins, or * for local development.
CORS_ORIGINS=*
DATABASE_URL=sqlite+aiosqlite:///./mintai.db
AUTO_CREATE_SCHEMA=false
SQL_ECHO=false
SQLITE_BUSY_TIMEOUT_SECONDS=30

# Set DATABASE_URL to postgresql+asyncpg://... to use PostgreSQL.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Payment providers. Configure these before accepting payment intents.
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
CRYPTO_DEPOSIT_ADDRESS=
TON_NETWORK=mainnet
TON_MIN_CONFIRMATIONS=1
TON_INDEXER_WEBHOOK_SECRET=replace-with-a-random-indexer-secret
USDT_JETTON_MASTER=
PAYMENT_QUOTE_MINUTES=30
PAYMENT_INTENT_TTL_MINUTES=60

# In-process background jobs; use a single worker-enabled instance.
ENABLE_BACKGROUND_WORKERS=true
WITHDRAWAL_WORKER_INTERVAL_SECONDS=15
DIVIDEND_BATCH_INTERVAL_SECONDS=300
PAYMENT_EXPIRY_INTERVAL_SECONDS=60
WITHDRAWAL_PROCESSING_STALE_SECONDS=300
RATE_LIMIT_PER_MINUTE=30

# Demo-only quote assumptions; production adapters must provide live fee quotes.
DEMO_TON_GAS_FEE_ESTIMATE=0.005
DEMO_TON_USD_ESTIMATE=5.0
WITHDRAWAL_QUOTE_TTL_SECONDS=300
