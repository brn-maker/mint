# Required to authenticate real Telegram Mini App requests in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_MINI_APP_SHORT_NAME=
REFERRAL_SALT=

# Local-only identity used when no Telegram bot token is configured.
ALLOW_DEMO_AUTH=true
DEMO_USER_ID=10001
ALLOW_DEMO_PAYMENTS=true

# Admin endpoint and treasury display/accounting target.
ADMIN_TOKEN=replace-with-a-long-random-secret
ADMIN_API_URL=http://127.0.0.1:8000
TREASURY_ACCOUNT=Mint AI Treasury

# Comma-separated origins, or * for local development.
CORS_ORIGINS=*
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?ssl=require
AUTO_CREATE_SCHEMA=false
SQL_ECHO=false

# Supabase PostgreSQL connection pool settings.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# TON testnet payment scanner. Keep the mnemonic and API key private.
TON_DEPOSIT_ADDRESS=
TON_NETWORK=testnet
TON_API_ENDPOINT=
TON_API_KEY=
APP_WALLET_MNEMONIC=
# Explicitly opt in only for a dedicated TON testnet wallet and database.
TON_TESTNET_PAYOUTS_ENABLED=false
TON_PAYMENT_SCAN_INTERVAL_SECONDS=10
PAYMENT_INTENT_TTL_MINUTES=60

# In-process background jobs; use a single worker-enabled instance.
ENABLE_BACKGROUND_WORKERS=true
WITHDRAWAL_WORKER_INTERVAL_SECONDS=15
DIVIDEND_BATCH_INTERVAL_SECONDS=300
PAYMENT_EXPIRY_INTERVAL_SECONDS=60
WITHDRAWAL_PROCESSING_STALE_SECONDS=300
RATE_LIMIT_PER_MINUTE=30

# Demo-only TON fee assumption; production adapters must provide live fee quotes.
DEMO_TON_GAS_FEE_ESTIMATE=0.005
WITHDRAWAL_QUOTE_TTL_SECONDS=300
